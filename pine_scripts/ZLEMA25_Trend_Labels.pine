//@version=6
// ─────────────────────────────────────────────────────────────────────────────
// ZLEMA25 Trend Labels — overlay
//
// What it does:
//   Plots ZLEMA25 (zero-lag EMA 25 of close) as a trend-riding line and labels
//   every ZLEMA25 uptrend segment with its length in bars and % change:
//     - Completed uptrends: silver label at the last rising bar of each segment
//       ("12d | +18.4%"). All segments labeled, including 1-2 bar blips.
//     - Current uptrend: live white label at the latest bar, updated per bar.
//     - Stats box (middle-right table): ZLEMA25 + EMA20 + EMA55 current-uptrend
//       age and % since trend start ("ZL25 12d | +8.4%"); dash when line not
//       rising. Vertical nudge via "Empty rows above/below" inputs. EMA20/EMA55
//       stats mirror the ZLEMA25 convention (base = close of bar before turn-up
//       bar). EMA55 optionally gets completed-segment labels too (orange, below
//       the bar, off by default via "Show EMA55 completed-segment labels") —
//       raw-slope trend, equivalent to a close/EMA55 crossover (see
//       ema55_cross_scanner.py).
//     - Turn-up candle (bar where ZLEMA25 starts rising AND a WaveTrend bull
//       cross fired within last N bars, default 3) recolored (default fuchsia) via
//       barcolor() — toggle, color, WT lookback in inputs. WT params mirror
//       wavetrend_scanner.py (n1=10, n2=21, hlc3, wt2=SMA(wt1,4)).
//   % base = close of the candle immediately BEFORE the turn-up candle — same
//   ZL Chg% reference as ema25_zl_scanner.py (see README "ZL Chg% reference").
//
// Companion: standalone overlay; pairs with any Satya_All_Panel setup.
// Alerts: none.
// ─────────────────────────────────────────────────────────────────────────────
indicator("ZLEMA25 Trend Labels", overlay=true, max_labels_count=500)

showZLEMA25 = input.bool(true, "ZLEMA 25")
lengthZLEMA25 = input.int(25, "Zero Lag EMA Length")
highlightMovementsZLEMA25 = input.bool(true, title="Highlight Movements ZLEMA25?")
srcZLEMA25 = input(close, title="Source")
lagZLEMA25 = math.floor((lengthZLEMA25 - 1) / 2)
zlema25 = ta.ema(srcZLEMA25 + (srcZLEMA25 - srcZLEMA25[lagZLEMA25]), lengthZLEMA25)
zlemaColor25 = highlightMovementsZLEMA25 ? (zlema25 > zlema25[1] ? color.white : color.red) : #6d1e7f
upTrend = zlema25 > zlema25[1]
downTrend = zlema25 < zlema25[1]

// Detect start of uptrend
upTrendStart = upTrend and not upTrend[1]

// Store start price/bar only when uptrend begins
var float upStartPrice = na
var int upStartBar = na

if upTrendStart
    upStartPrice := close[1]
    upStartBar := bar_index

// Label every completed uptrend at its last rising bar.
// Must run BEFORE the downTrend reset below, while start price/bar are still valid.
// "not upTrend and upTrend[1]" also catches an exactly-flat ZLEMA (no float ==).
upTrendEnd = not upTrend and upTrend[1]

if upTrendEnd and not na(upStartBar) and not na(upStartPrice)
    endDays = (bar_index - 1) - upStartBar
    endPct = ((close[1] - upStartPrice) / upStartPrice) * 100
    endText = str.tostring(endDays) + "d | " + str.tostring(endPct, "#.##") + "%"
    label.new(bar_index - 1, high[1], endText,
         style=label.style_label_down,
         textcolor=color.silver,
         color=color.new(color.black, 99))

// Reset when trend is down
if downTrend
    upStartPrice := na
    upStartBar := na

// Stats only during uptrend
daysFromStart = upTrend and not na(upStartBar) ? (bar_index - upStartBar) : na
pctChangeFromStart = upTrend and not na(upStartPrice) ? ((close - upStartPrice) / upStartPrice) * 100 : na

// Plot ZLEMA
//plot(showZLEMA25 ? zlema25 : na, title="ZLEMA 25", color=zlemaColor25, linewidth=2)

// WaveTrend (params mirror wavetrend_scanner.py: n1=10, n2=21, hlc3, wt2=SMA(wt1,4))
wtN1 = input.int(10, "WT Channel Length")
wtN2 = input.int(21, "WT Average Length")
wtAp = hlc3
wtEsa = ta.ema(wtAp, wtN1)
wtD = ta.ema(math.abs(wtAp - wtEsa), wtN1)
wtCi = (wtAp - wtEsa) / (0.015 * wtD)
wt1 = ta.ema(wtCi, wtN2)
wt2 = ta.sma(wt1, 4)
wtBullCross = ta.crossover(wt1, wt2)

// Recolor the turn-up candle: ZLEMA25 uptrend start AND WT bull cross within lookback
paintTurnCandle = input.bool(true, "Paint ZLEMA25 turn-up candle")
turnCandleColor = input.color(color.fuchsia, "Turn-up candle color")
wtCrossLookback = input.int(3, "WT bull cross within N bars", minval=0)
wtBullRecent = ta.barssince(wtBullCross) <= wtCrossLookback
barcolor(paintTurnCandle and upTrendStart and wtBullRecent ? turnCandleColor : na, title="ZLEMA25 turn-up + WT bull cross candle")

// Live label for current uptrend
var label statsLabel = na
if barstate.islast
    label.delete(statsLabel)
    if upTrend and not na(daysFromStart) and not na(pctChangeFromStart)
        statsText = "ZLEMA25\n" + str.tostring(daysFromStart) + "d | " + str.tostring(pctChangeFromStart, "#.##") + "%"
        statsLabel := label.new(bar_index, high, statsText, style=label.style_label_down, textcolor=color.white, color=color.new(color.black, 99))

// ── Stats box: ZLEMA25 + EMA20 current-uptrend age / % since trend start ────
grpBox = "Stats Box"
showStatsBox = input.bool(true, "Show stats box", group=grpBox)
padAbove = input.int(4, "Empty rows above (push box down)", minval=0, group=grpBox)
padBelow = input.int(0, "Empty rows below (push box up)", minval=0, group=grpBox)
ema20Len = input.int(20, "EMA length (2nd row)", minval=1, group=grpBox)

// EMA20 trend stats — mirrors ZLEMA25 convention: start = turn-up bar,
// % base = close of the bar BEFORE the turn-up bar.
ema20 = ta.ema(close, ema20Len)
emaUpTrend = ema20 > ema20[1]
emaDownTrend = ema20 < ema20[1]
emaUpStart = emaUpTrend and not emaUpTrend[1]

var float emaStartPrice = na
var int emaStartBar = na
if emaUpStart
    emaStartPrice := close[1]
    emaStartBar := bar_index
if emaDownTrend
    emaStartPrice := na
    emaStartBar := na

emaDaysFromStart = emaUpTrend and not na(emaStartBar) ? (bar_index - emaStartBar) : na
emaPctFromStart = emaUpTrend and not na(emaStartPrice) ? ((close - emaStartPrice) / emaStartPrice) * 100 : na

// EMA55 trend stats — same raw-slope convention as ZL25/EMA20 above.
// Note (pine-script-conventions.md parity): for a plain EMA, raw slope-turn
// == close crossing above the EMA, always (see ema55_cross_scanner.py
// ema55_cross_stats() docstring) — this row fires same-day as that Python
// crossover stat, not its 5-bar-smoothed ema55_trend_age().
ema55Len = input.int(55, "EMA length (3rd row)", minval=1, group=grpBox)
showEMA55Labels = input.bool(false, "Show EMA55 completed-segment labels", group=grpBox)
ema55 = ta.ema(close, ema55Len)
ema55UpTrend = ema55 > ema55[1]
ema55DownTrend = ema55 < ema55[1]
ema55UpTrendStart = ema55UpTrend and not ema55UpTrend[1]

var float ema55StartPrice = na
var int ema55StartBar = na
if ema55UpTrendStart
    ema55StartPrice := close[1]
    ema55StartBar := bar_index

// Label every completed EMA55 uptrend at its last rising bar (mirrors ZL25 block above).
ema55UpTrendEnd = not ema55UpTrend and ema55UpTrend[1]
if showEMA55Labels and ema55UpTrendEnd and not na(ema55StartBar) and not na(ema55StartPrice)
    ema55EndDays = (bar_index - 1) - ema55StartBar
    ema55EndPct = ((close[1] - ema55StartPrice) / ema55StartPrice) * 100
    ema55EndText = str.tostring(ema55EndDays) + "d | " + str.tostring(ema55EndPct, "#.##") + "%"
    label.new(bar_index - 1, low[1], ema55EndText,
         style=label.style_label_up,
         textcolor=color.orange,
         color=color.new(color.black, 99))

if ema55DownTrend
    ema55StartPrice := na
    ema55StartBar := na

ema55DaysFromStart = ema55UpTrend and not na(ema55StartBar) ? (bar_index - ema55StartBar) : na
ema55PctFromStart = ema55UpTrend and not na(ema55StartPrice) ? ((close - ema55StartPrice) / ema55StartPrice) * 100 : na

var table statsBox = na
if barstate.islast
    table.delete(statsBox)
    if showStatsBox
        statsBox := table.new(position.middle_right, 1, padAbove + 3 + padBelow)
        cellBg = color.new(color.black, 99)
        padBg = color.new(color.black, 100)
        // pad cells need " " (not "") — empty-text cells collapse to zero height
        if padAbove > 0
            for i = 0 to padAbove - 1
                table.cell(statsBox, 0, i, " ", text_size=size.small, bgcolor=padBg)
        zlText = not na(daysFromStart) and not na(pctChangeFromStart) ? "ZL25  " + str.tostring(daysFromStart) + "d | " + str.tostring(pctChangeFromStart, "#.##") + "%" : "ZL25  —"
        emaText = not na(emaDaysFromStart) and not na(emaPctFromStart) ? "EMA20 " + str.tostring(emaDaysFromStart) + "d | " + str.tostring(emaPctFromStart, "#.##") + "%" : "EMA20 —"
        ema55Text = not na(ema55DaysFromStart) and not na(ema55PctFromStart) ? "EMA55 " + str.tostring(ema55DaysFromStart) + "d | " + str.tostring(ema55PctFromStart, "#.##") + "%" : "EMA55 —"
        table.cell(statsBox, 0, padAbove, zlText, text_color=color.white, text_size=size.small, text_halign=text.align_left, bgcolor=cellBg)
        table.cell(statsBox, 0, padAbove + 1, emaText, text_color=color.white, text_size=size.small, text_halign=text.align_left, bgcolor=cellBg)
        table.cell(statsBox, 0, padAbove + 2, ema55Text, text_color=color.white, text_size=size.small, text_halign=text.align_left, bgcolor=cellBg)
        if padBelow > 0
            for i = 0 to padBelow - 1
                table.cell(statsBox, 0, padAbove + 3 + i, " ", text_size=size.small, bgcolor=padBg)

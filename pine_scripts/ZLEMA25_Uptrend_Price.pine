//@version=6
// Daily ZLEMA25 rising-slope close threshold for any stock on a 1D chart.
// Educational use only. Consult a SEBI registered investment advisor.
indicator("Satya Daily ZLEMA25 Uptrend Price", overlay=true, max_lines_count=1, max_labels_count=1)

showDailyTurnPrice = input.bool(true, "Show upcoming first ZL25 UP price (1D only)")
dailyTurnColor = input.color(color.aqua, "Trigger line color")
isDailyChart = timeframe.isdaily and timeframe.multiplier == 1
dailyCloseZlema = ta.ema(2 * close - close[12], 25)

// Open candle: solve for today's close from yesterday's confirmed EMA.
// Closed candle: solve for next session, whose lag-12 close is today's close[11].
baseZlema = barstate.isconfirmed ? dailyCloseZlema : dailyCloseZlema[1]
basePriorZlema = barstate.isconfirmed ? dailyCloseZlema[1] : dailyCloseZlema[2]
laggedClose = barstate.isconfirmed ? close[11] : close[12]
waitingForFirstUp = baseZlema <= basePriorZlema
// A strictly greater close makes ZLEMA rise. Equality means flat.
dailyTurnBoundary = (baseZlema + laggedClose) / 2
dailyTurnPrice = (math.floor(dailyTurnBoundary / syminfo.mintick) + 1) * syminfo.mintick

var line dailyTurnLine = na
var label dailyTurnLabel = na
if barstate.islast
    line.delete(dailyTurnLine)
    label.delete(dailyTurnLabel)
    if showDailyTurnPrice and isDailyChart and waitingForFirstUp and not na(dailyTurnPrice)
        projectionEnd = time + 14 * 24 * 60 * 60 * 1000
        dailyTurnLine := line.new(time, dailyTurnPrice, projectionEnd, dailyTurnPrice,
             xloc=xloc.bar_time, color=dailyTurnColor, style=line.style_solid, width=1)
        targetText = barstate.isconfirmed ? "Next session" : "Today"
        dailyTurnLabel := label.new(projectionEnd, dailyTurnPrice,
             "ZL25 UP " + targetText + " >= " + str.tostring(dailyTurnPrice, format.mintick),
             xloc=xloc.bar_time, style=label.style_label_left,
             textcolor=dailyTurnColor, color=color.new(color.black, 85),
             tooltip="Minimum close needed for the first rising ZLEMA25 candle after a flat/falling candle. Hidden when the last confirmed slope is already rising. Updates after every daily close; the 14-day extension is a visual guide, not a fixed two-week forecast.")

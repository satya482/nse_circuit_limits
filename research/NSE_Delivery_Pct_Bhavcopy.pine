//@version=6
indicator("NSE Delivery % — Bhavcopy", shorttitle="NSE·Deliv%",
     overlay=false, max_bars_back=1000)

// ══════════════════════════════════════════════════════════════════════════
// NSE Delivery % — Bhavcopy Mapper  |  Pine Script v6
//
// Paste NSE equity bhavcopy rows (quoted or unquoted) into the Settings
// text area.  Auto-filters for the current chart symbol, reads
// Date (col 2) and % Dly Qt to Traded Qty (col 14).
//
// ALERT SETUP (one-time):
//   Chart → Alerts → + → condition "⚡ Any Delivery Signal"
//   → enable Webhook → paste your endpoint URL
// ══════════════════════════════════════════════════════════════════════════

// ══════════════════════════════════════════════════════════════════════════
// §1  INPUTS
// ══════════════════════════════════════════════════════════════════════════

i_csv = input.text_area(
    defval  = 'CUPID,EQ,07-Jan-2026,,,,,,,,,,,,12.54\n'
            + 'CUPID,EQ,08-Jan-2026,,,,,,,,,,,,18.33\n'
            + 'CUPID,EQ,09-Jan-2026,,,,,,,,,,,,13.61',
    title   = "NSE Bhavcopy rows",
    tooltip = "Paste NSE equity bhavcopy rows (with or without header).\n"
            + "Quoted bhavcopy format (copy-paste directly):\n"
            + '  "CUPID","EQ","07-Jan-2026",...,"12.54"\n'
            + "Unquoted (empty unused cols):\n"
            + "  CUPID,EQ,07-Jan-2026,,,,,,,,,,,,12.54\n"
            + "Date accepted as DD-Mon-YYYY or YYYY-MM-DD.",
    group   = "📥 Bhavcopy Data"
)

i_series = input.string("EQ", "Series filter (blank = all)",
     tooltip = "EQ = regular equity. Blank includes all series.",
     group   = "📥 Bhavcopy Data"
)

i_cSym  = input.int(0,  "Symbol column #",    minval=0, maxval=30, group="⚙️ Column Map",
     tooltip = "0 = col A  (Symbol)")
i_cSer  = input.int(1,  "Series column #",    minval=0, maxval=30, group="⚙️ Column Map",
     tooltip = "1 = col B  (Series)")
i_cDate = input.int(2,  "Date column #",      minval=0, maxval=30, group="⚙️ Column Map",
     tooltip = "2 = col C  (Date)")
i_cPct  = input.int(14, "Delivery% column #", minval=0, maxval=30, group="⚙️ Column Map",
     tooltip = "14 = col O  (% Dly Qt to Traded Qty)")

i_hiThr = input.float(70.0, "High Delivery %",
     minval=0.0, maxval=100.0, step=0.5, group="🎯 Thresholds")
i_loThr = input.float(20.0, "Low  Delivery %",
     minval=0.0, maxval=100.0, step=0.5, group="🎯 Thresholds")

i_lbl  = input.bool(true,                    "Labels on signal bars", group="🎨 Display")
i_bg   = input.bool(true,                    "Background highlight",  group="🎨 Display")
i_tbl  = input.bool(true,                    "Info table",            group="🎨 Display")
i_cHi  = input.color(color.new(#00C853, 0),  "High color",            group="🎨 Display")
i_cLo  = input.color(color.new(#F44336, 0),  "Low color",             group="🎨 Display")
i_cMid = input.color(color.new(#1976D2, 40), "Normal color",          group="🎨 Display")

// ══════════════════════════════════════════════════════════════════════════
// §2  STRING HELPERS
// ══════════════════════════════════════════════════════════════════════════

// Strip all spaces (one per iteration — Pine Script has no replace-all)
stripS(s) =>
    string r = s
    int n = 0
    while str.contains(r, " ") and n < 30
        r := str.replace(r, " ", "")
        n += 1
    r

// Strip all double-quote characters
stripQ(s) =>
    string r = s
    int n = 0
    while str.contains(r, '"') and n < 10
        r := str.replace(r, '"', "")
        n += 1
    r

// Strip spaces then leftover quotes
clean(s) => stripQ(stripS(s))

// ── Month name → zero-padded number ──────────────────────────────────────
// FIX: multi-line ternary chains ending with ":" cause CE10156 in Pine
//      Script because ":" at end-of-line is not a continuation operator.
//      switch avoids that entirely.
monToNum(m) =>
    switch str.upper(m)
        "JAN" => "01"
        "FEB" => "02"
        "MAR" => "03"
        "APR" => "04"
        "MAY" => "05"
        "JUN" => "06"
        "JUL" => "07"
        "AUG" => "08"
        "SEP" => "09"
        "OCT" => "10"
        "NOV" => "11"
        "DEC" => "12"
        => na

// Normalise date → "YYYY-MM-DD"
// Handles DD-Mon-YYYY (07-Jan-2026, 07-JAN-2026) and YYYY-MM-DD
normDate(raw) =>
    d = clean(raw)
    string r = na
    if str.length(d) == 10 and str.substring(d, 4, 5) == "-" and str.substring(d, 7, 8) == "-"
        r := d
    if na(r)
        p = str.split(d, "-")
        if array.size(p) == 3
            mm = monToNum(array.get(p, 1))
            yr = array.get(p, 2)
            if not na(mm) and str.length(yr) == 4
                r := yr + "-" + mm + "-" + array.get(p, 0)
    r

// ══════════════════════════════════════════════════════════════════════════
// §3  ROW SPLITTER
//     Quoted bhavcopy: split on '","' so Indian-format numbers like
//     "6,50,84,299" stay in one column.  Strip the single outer quote
//     left on field[0] and field[last].
//     Unquoted rows: plain ',' split.
// ══════════════════════════════════════════════════════════════════════════

splitRow(row) =>
    array<string> cols = na
    if str.length(row) > 0 and str.substring(row, 0, 1) == '"'
        cols := str.split(row, '","')
        nc = array.size(cols)
        if nc > 0
            f0 = array.get(cols, 0)
            if str.length(f0) > 0 and str.substring(f0, 0, 1) == '"'
                array.set(cols, 0, str.substring(f0, 1, str.length(f0)))
            fl = array.get(cols, nc - 1)
            ln = str.length(fl)
            if ln > 0 and str.substring(fl, ln - 1, ln) == '"'
                array.set(cols, nc - 1, str.substring(fl, 0, ln - 1))
    else
        cols := str.split(row, ',')
    cols

// ══════════════════════════════════════════════════════════════════════════
// §4  CSV PARSING  — once on barstate.isfirst per full recalculation
// ══════════════════════════════════════════════════════════════════════════

var array<string> _D = array.new<string>()
var array<float>  _V = array.new<float>()

if barstate.isfirst
    array.clear(_D)
    array.clear(_V)
    rows    = str.split(i_csv, "\n")
    maxReqd = math.max(i_cSym, math.max(i_cSer, math.max(i_cDate, i_cPct)))
    ticker  = str.upper(syminfo.ticker)
    serFilt = str.upper(i_series)

    for i = 0 to array.size(rows) - 1
        row = array.get(rows, i)
        row := str.replace(row, "\r", "")
        if str.length(row) < 5
            continue
        cols = splitRow(row)
        if array.size(cols) <= maxReqd
            continue
        sym = str.upper(clean(array.get(cols, i_cSym)))
        // Skip header rows (with or without BOM prefix before "SYMBOL")
        if str.length(sym) == 0 or str.contains(sym, "SYMBOL")
            continue
        if sym != ticker
            continue
        if str.length(serFilt) > 0
            if str.upper(clean(array.get(cols, i_cSer))) != serFilt
                continue
        nd  = normDate(array.get(cols, i_cDate))
        val = str.tonumber(clean(array.get(cols, i_cPct)))
        if not na(nd) and not na(val)
            array.push(_D, nd)
            array.push(_V, val)

// ══════════════════════════════════════════════════════════════════════════
// §5  PER-BAR LOOKUP
// ══════════════════════════════════════════════════════════════════════════

_mm    = month      < 10 ? "0" + str.tostring(month)      : str.tostring(month)
_dd    = dayofmonth < 10 ? "0" + str.tostring(dayofmonth) : str.tostring(dayofmonth)
barISO = str.tostring(year) + "-" + _mm + "-" + _dd

float pct = na
for i = 0 to array.size(_D) - 1
    if array.get(_D, i) == barISO
        pct := array.get(_V, i)
        break

// ══════════════════════════════════════════════════════════════════════════
// §6  SIGNALS
// ══════════════════════════════════════════════════════════════════════════

bool hasData = not na(pct)
bool sigHi   = hasData and pct >= i_hiThr
bool sigLo   = hasData and pct <= i_loThr
bool sigMid  = hasData and not sigHi and not sigLo

// FIX: multi-branch ternaries kept on ONE line to avoid CE10156
// (a ternary split so the line ends mid-expression before ":" is ambiguous)
color bCol = sigHi ? i_cHi : sigLo ? i_cLo : sigMid ? i_cMid : color.new(color.gray, 80)

// ══════════════════════════════════════════════════════════════════════════
// §7  VISUALS
// ══════════════════════════════════════════════════════════════════════════

plot(pct, "Delivery %", style=plot.style_columns, color=bCol)

hline(i_hiThr, "High Thr",
      color=color.new(#00C853, 50), linestyle=hline.style_dashed, linewidth=1)
hline(i_loThr, "Low Thr",
      color=color.new(#F44336, 50), linestyle=hline.style_dashed, linewidth=1)
hline(50.0, "50% Mid",
      color=color.new(color.gray, 70), linestyle=hline.style_dotted, linewidth=1)

bgcolor(i_bg and sigHi ? color.new(i_cHi, 88) : na, title="High BG")
bgcolor(i_bg and sigLo ? color.new(i_cLo, 88) : na, title="Low BG")

if i_lbl and (sigHi or sigLo) and barstate.isconfirmed
    label.new(
         bar_index, pct,
         str.tostring(math.round(pct, 1)) + "%",
         style     = sigHi ? label.style_label_up : label.style_label_down,
         color     = color.new(bCol, 40),
         textcolor = color.white,
         size      = size.small
    )

var table T = table.new(position.top_right, 2, 5,
     bgcolor      = color.new(#0D1117, 75),
     border_color = color.new(color.gray, 60),
     border_width = 1, frame_width = 1,
     frame_color  = color.new(color.gray, 50))

if i_tbl and barstate.islast
    table.cell(T, 0, 0, "NSE  DELIVERY  %",
         bgcolor=color.new(#1A237E, 30), text_color=color.white, text_size=size.small)
    table.cell(T, 1, 0, "", bgcolor=color.new(#1A237E, 30))
    table.merge_cells(T, 0, 0, 1, 0)

    table.cell(T, 0, 1, "Date",   text_color=color.gray,  text_size=size.small)
    table.cell(T, 1, 1, barISO,   text_color=color.white, text_size=size.small)

    table.cell(T, 0, 2, "Deliv %", text_color=color.gray, text_size=size.small)
    table.cell(T, 1, 2,
         hasData ? str.tostring(math.round(pct, 2)) + "%" : "—",
         text_color=hasData ? bCol : color.gray, text_size=size.small)

    // FIX: single-line ternaries in table cells (same CE10156 risk)
    sigTxt = sigHi ? "▲ HIGH" : sigLo ? "▼ LOW" : sigMid ? "● NORMAL" : "— NO DATA"
    sigCol = sigHi ? i_cHi   : sigLo ? i_cLo   : sigMid ? i_cMid    : color.gray
    table.cell(T, 0, 3, "Signal",  text_color=color.gray, text_size=size.small)
    table.cell(T, 1, 3, sigTxt,    text_color=sigCol,     text_size=size.small)

    table.cell(T, 0, 4, "Rows loaded",
         text_color=color.gray,               text_size=size.tiny)
    table.cell(T, 1, 4, str.tostring(array.size(_D)),
         text_color=color.new(color.white, 30), text_size=size.tiny)

// ══════════════════════════════════════════════════════════════════════════
// §8  ALERTS  — always active, no user toggle required
//
//  ─── One-time TradingView alert setup ────────────────────────────────
//  Chart → Alerts → + → Condition: this indicator → "⚡ Any Delivery Signal"
//  → Webhook URL: <your endpoint>    → Frequency: Once per bar close
//  Both HIGH and LOW signals fire through the same alert with distinct JSON.
//
//  ─── Webhook payload (HIGH) ──────────────────────────────────────────
//  {
//    "indicator"    : "NSE_DELIVERY",
//    "signal"       : "HIGH_DELIVERY",
//    "ticker"       : "CUPID",
//    "exchange"     : "NSE",
//    "date"         : "2026-07-06",
//    "delivery_pct" : 22.84,
//    "threshold_hi" : 70.0,
//    "close"        : 213.09
//  }
//
//  ─── Webhook payload (LOW) ───────────────────────────────────────────
//  {
//    "indicator"    : "NSE_DELIVERY",
//    "signal"       : "LOW_DELIVERY",
//    "ticker"       : "CUPID",
//    "exchange"     : "NSE",
//    "date"         : "2026-01-07",
//    "delivery_pct" : 12.54,
//    "threshold_lo" : 20.0,
//    "close"        : 433.80
//  }
// ══════════════════════════════════════════════════════════════════════════

// ── alert() — dynamic JSON → webhook ─────────────────────────────────────
if sigHi and barstate.isconfirmed
    alert(
        '{"indicator":"NSE_DELIVERY",'  +
        '"signal":"HIGH_DELIVERY",'     +
        '"ticker":"'    + syminfo.ticker                        + '",' +
        '"exchange":"'  + syminfo.prefix                        + '",' +
        '"date":"'      + barISO                                + '",' +
        '"delivery_pct":' + str.tostring(math.round(pct,   2)) + ',' +
        '"threshold_hi":' + str.tostring(i_hiThr)              + ',' +
        '"close":'        + str.tostring(math.round(close, 2)) + '}',
        alert.freq_once_per_bar_close
    )

if sigLo and barstate.isconfirmed
    alert(
        '{"indicator":"NSE_DELIVERY",' +
        '"signal":"LOW_DELIVERY",'     +
        '"ticker":"'    + syminfo.ticker                        + '",' +
        '"exchange":"'  + syminfo.prefix                        + '",' +
        '"date":"'      + barISO                                + '",' +
        '"delivery_pct":' + str.tostring(math.round(pct,   2)) + ',' +
        '"threshold_lo":' + str.tostring(i_loThr)              + ',' +
        '"close":'        + str.tostring(math.round(close, 2)) + '}',
        alert.freq_once_per_bar_close
    )

// ── alertcondition() — static labels for TradingView UI alert creation ────
alertcondition(sigHi,          "🟢 High Delivery Day",   "NSE Delivery HIGH — webhook payload fired")
alertcondition(sigLo,          "🔴 Low Delivery Day",    "NSE Delivery LOW — webhook payload fired")
alertcondition(sigHi or sigLo, "⚡ Any Delivery Signal", "NSE Delivery signal — see webhook for payload")
